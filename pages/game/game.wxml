<view class="page game-page {{largeFont?'large-font':''}}">
  <!-- 背景特效 canvas -->
  <canvas type="2d" id="fx" class="fx-canvas"></canvas>

  <view class="game-content">
    <view class="game-head">
      <view class="head-meta">
        <view class="head-title">陕北捉老麻</view>
        <view class="head-sub">{{gameMeta}}</view>
      </view>
      <view class="head-actions">
        <button class="icon-btn" size="mini" bindtap="onRestart">重开</button>
        <button class="icon-btn" size="mini" bindtap="onExit">退出</button>
      </view>
    </view>

    <!-- 座位 -->
    <view class="seat-row">
      <view wx:for="{{seats}}" wx:key="seat" class="seat {{item.active?'active':''}}">
        <view class="seat-name">{{item.name}}</view>
        <view class="seat-count">剩 {{item.count}} 张</view>
        <view wx:if="{{item.declared}}" class="seat-declared">报牌 {{item.declared}}</view>
      </view>
    </view>

    <!-- 上一手出牌 -->
    <view class="play-zone">
      <view class="play-label">{{playLabel}}</view>
      <view class="card-row small">
        <view wx:for="{{lastCards}}" wx:key="id" class="card small {{item.red?'red':'black'}}">
          <view class="card-rank">{{item.rank}}</view>
          <view class="card-suit">{{item.suitText}}</view>
        </view>
        <view wx:if="{{!lastCards.length}}" class="play-empty">—</view>
      </view>
    </view>

    <!-- 强制规则提示 -->
    <view wx:if="{{forceText}}" class="force-line">{{forceText}}</view>
    <!-- 报牌提示 -->
    <view wx:if="{{declaredText}}" class="declared-line">{{declaredText}}</view>

    <!-- 状态行 -->
    <view class="status-line">{{statusText}}</view>

    <!-- 手牌 -->
    <view class="hand-zone">
      <view class="hand-title">{{handTitle}}</view>
      <scroll-view scroll-x class="hand-scroll">
        <view class="card-row hand">
          <view wx:for="{{hand}}" wx:key="id"
                class="card {{item.red?'red':'black'}} {{item.selected?'selected':''}}"
                data-id="{{item.id}}" bindtap="onCardTap">
            <view class="card-rank">{{item.rank}}</view>
            <view class="card-suit">{{item.suitText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-row">
      <button class="btn act" disabled="{{!canPlay}}" bindtap="onPlay">出牌</button>
      <button class="btn btn-outline act {{passEmphasis?'emph':''}}" disabled="{{!canPass}}" bindtap="onPass">不出</button>
      <button class="btn btn-outline act" disabled="{{!canHint}}" bindtap="onHint">提示</button>
    </view>
  </view>

  <!-- 热座交接遮罩 -->
  <view wx:if="{{handoff}}" class="mask">
    <view class="mask-card">
      <view class="mask-title">请交接设备</view>
      <view class="mask-name">{{handoffName}} 请接手</view>
      <view class="muted">确认周围无人观看手牌后点击</view>
      <button class="btn btn-block" bindtap="onHandoff">我已接手</button>
    </view>
  </view>
</view>
