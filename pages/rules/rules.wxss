.rule-p { font-size: 26rpx; line-height: 1.8; color: var(--ink); }
.rule-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.rule-item {
  width: calc(50% - 8rpx); box-sizing: border-box;
  background: rgba(232,197,122,0.06); border-radius: 12rpx; padding: 18rpx;
}
.rule-name { font-size: 26rpx; font-weight: 500; color: var(--gold); margin-bottom: 8rpx; }
.rule-desc { font-size: 22rpx; color: var(--gold-dim); line-height: 1.5; }
