.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 1rpx solid rgba(44, 242, 255, 0.09);
}
.setting-row:last-child { border-bottom: none; }
.setting-name { font-size: 28rpx; color: var(--ink); }
.setting-desc { font-size: 21rpx; color: var(--ink-3); margin-top: 6rpx; }
.rule-p { font-size: 25rpx; line-height: 1.8; color: var(--ink-2); }
.link-arrow { font-size: 40rpx; color: var(--ink-3); line-height: 1; padding-left: 16rpx; }
/* 迷你按钮：霓虹灯管，不做实心色块 */
.icon-btn {
  background: rgba(44, 242, 255, 0.08);
  border: 1rpx solid rgba(44, 242, 255, 0.45);
  color: var(--cyan);
  border-radius: 2rpx;
  font-size: 23rpx;
  padding: 0 22rpx;
  line-height: 2.1;
}
.icon-btn::after { border: none; }
