<view class="page {{largeFont?'large-font':''}}">
  <view class="panel">
    <view class="panel-title">音效与提示</view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">背景音乐</view>
        <view class="setting-desc">程序合成旋律，循环播放</view>
      </view>
      <switch checked="{{bgm}}" color="#E8C57A" bindchange="onBgm" />
    </view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">语音提示</view>
        <view class="setting-desc">出牌、轮次、炸弹音效</view>
      </view>
      <switch checked="{{dialect}}" color="#E8C57A" bindchange="onDialect" />
    </view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">大字模式</view>
        <view class="setting-desc">放大牌面与规则文字</view>
      </view>
      <switch checked="{{largeFont}}" color="#E8C57A" bindchange="onFont" />
    </view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">振动反馈</view>
        <view class="setting-desc">出牌与炸弹时振动</view>
      </view>
      <switch checked="{{vibration}}" color="#E8C57A" bindchange="onVibration" />
    </view>
  </view>
  <view class="panel">
    <view class="panel-title">引导</view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">重看新手引导</view>
        <view class="setting-desc">下次进入牌桌时再次展示三句话说明</view>
      </view>
      <button class="icon-btn" size="mini" bindtap="onResetGuide">重看</button>
    </view>
  </view>
  <view class="panel">
    <view class="panel-title">关于</view>
    <view class="rule-p">陕北捉老麻 · 娱乐牌局。积分仅作本地娱乐记录，不涉及任何真实货币或物品兑换。</view>
  </view>
  <!-- [RELEASE 2026-11-19] 隐私接口（保存战绩图走相册）必须有页内可点开的指引正文，
       仅在后台勾选声明是不够的，审核会同时核对页内入口。 -->
  <view class="panel">
    <view class="panel-title">协议与数据</view>
    <view class="setting-row" bindtap="onPrivacy">
      <view class="setting-info">
        <view class="setting-name">用户隐私保护指引</view>
        <view class="setting-desc">说明用到的权限、数据存在哪里、如何删除</view>
      </view>
      <view class="link-arrow">›</view>
    </view>
  </view>
  <!-- [RELEASE 2026-11-18] 线上排错出口：小程序无控制台，玩家遇到白屏时我们拿不到现场。
       这里把最近异常复制出来，是提审前最低成本的"反馈通道"。 -->
  <view class="panel">
    <view class="panel-title">运行诊断</view>
    <view class="setting-row">
      <view class="setting-info">
        <view class="setting-name">异常记录</view>
        <view class="setting-desc">{{errorCount ? '最近 ' + errorCount + ' 条，可复制后反馈' : '暂无异常记录'}}</view>
      </view>
      <button class="icon-btn" size="mini" bindtap="onCopyErrors">复制</button>
    </view>
  </view>
</view>
