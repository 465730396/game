.rule-p { font-size: 26rpx; line-height: 1.85; color: var(--ink); margin-bottom: 12rpx; }
.rule-p:last-child { margin-bottom: 0; }
.foot-note { text-align: center; font-size: 20rpx; color: var(--ink-3); padding: 8rpx 0 24rpx; letter-spacing: 1rpx; }

/* 设置行样式与设置页保持一致（面板内的行 + 迷你按钮） */
.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-top: 1rpx solid rgba(44, 242, 255, 0.09);
}
.setting-row:first-of-type { border-top: none; }
.setting-info { flex: 1; padding-right: 20rpx; }
.setting-name { font-size: 28rpx; color: var(--ink); }
.setting-desc { font-size: 21rpx; color: var(--ink-3); margin-top: 6rpx; }
.icon-btn {
  background: rgba(44, 242, 255, 0.08);
  border: 1rpx solid rgba(44, 242, 255, 0.45);
  color: var(--cyan);
  border-radius: 2rpx;
  font-size: 23rpx; padding: 0 20rpx; line-height: 2.1;
}
.icon-btn::after { border: none; }
