.stat-grid { display: flex; flex-wrap: wrap; }
.stat-cell { width: 25%; text-align: center; padding: 12rpx 0; }
.stat-num {
  font-size: 42rpx; font-weight: 900; color: var(--cyan);
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
  text-shadow: 0 0 20rpx rgba(44, 242, 255, 0.45);
}
.stat-label { font-size: 20rpx; color: var(--ink-3); margin-top: 8rpx; letter-spacing: 2rpx; }
.empty { text-align: center; color: var(--ink-3); font-size: 24rpx; padding: 32rpx 0; }
.list-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(44, 242, 255, 0.09);
}
.list-main { font-size: 26rpx; color: var(--ink); }
.list-title { font-size: 26rpx; }
.list-sub { font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }
.list-score { font-size: 30rpx; font-weight: 800; font-family: "DIN Alternate", sans-serif; }
.list-score.up { color: var(--magenta); }
.list-score.down { color: var(--jade); }
.clear-btn { margin-top: 8rpx; }
