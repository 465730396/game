<view class="page result-page {{largeFont?'large-font':''}}">
  <view wx:if="{{noData}}" class="result-head">
    <view class="result-badge draw">—</view>
    <view class="result-title">{{title}}</view>
    <view class="result-sub">结算数据未保留（小程序可能被回收），返回首页可重新开局</view>
  </view>

  <block wx:else>
    <view class="result-head">
      <view class="result-badge {{badgeClass}}">{{badgeText}}</view>
      <view class="result-title">{{title}}</view>
      <view class="result-sub">娱乐积分 · {{ruleSetId}} · {{time}}</view>
    </view>

    <view class="panel">
      <view class="panel-title">本局积分</view>
      <view wx:for="{{scores}}" wx:key="seat" class="score-row">
        <view class="score-left">
          <view class="rank-chip {{item.rank===1?'first':''}}">{{item.rank}}</view>
          <view class="score-info">
            <view class="score-name">{{item.name}}</view>
            <view class="score-sub">剩 {{item.remaining}} 张<text wx:if="{{item.bombCount}}"> · 炸弹 {{item.bombCount}}</text></view>
          </view>
        </view>
        <view class="score-delta {{item.delta>0?'up':'down'}}">{{item.delta>0?'+':''}}{{item.delta}}</view>
      </view>
    </view>
  </block>

  <view class="btn-row" wx:if="{{!noData}}">
    <button class="btn" bindtap="onAgain">再来一局</button>
    <button class="btn btn-outline" bindtap="onHome">返回首页</button>
  </view>
  <button wx:else class="btn btn-block" bindtap="onHome">返回首页</button>

  <button wx:if="{{!noData}}" class="btn btn-outline btn-block share-btn" open-type="share">分享给好友</button>
</view>
