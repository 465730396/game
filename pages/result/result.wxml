<view class="page result-page {{largeFont?'large-font':''}}">
  <view wx:if="{{noData}}" class="result-head">
    <view class="medal-wrap">
      <view class="medal-ring"></view>
      <view class="result-badge draw">—</view>
    </view>
    <view class="result-title">{{title}}</view>
    <view class="result-sub">结算数据未保留（小程序可能被回收），返回首页可重新开局。</view>
  </view>

  <block wx:else>
    <view class="result-head">
      <view class="medal-wrap {{badgeClass}}">
        <view class="medal-ring"></view>
        <view class="medal-ring inner"></view>
        <view class="result-badge {{badgeClass}}">{{badgeText}}</view>
      </view>
      <view class="result-title">{{title}}</view>
      <view class="result-sub">{{roundLabel ? roundLabel + ' · ' : ''}}娱乐积分 · {{time}}</view>
      <view wx:if="{{multiText}}" class="result-multi">{{multiText}}</view>
      <view wx:if="{{dailyTip}}" class="daily-tip">{{dailyTip}}</view>
    </view>

    <view class="panel">
      <view class="panel-title">本局积分</view>
      <view wx:for="{{scores}}" wx:key="seat" class="score-row">
        <view class="score-left">
          <view class="rank-chip {{item.rank===1?'first':item.rank===2?'second':''}}">{{item.rank}}</view>
          <view class="score-info">
            <view class="score-name">{{item.name}}</view>
            <view class="score-sub">剩 {{item.remaining}} 张<text wx:if="{{item.bombCount}}"> · 炸弹 {{item.bombCount}}</text></view>
          </view>
        </view>
        <view class="score-delta {{item.delta>0?'up':'down'}}">{{item.delta>0?'+':''}}{{item.delta}}</view>
      </view>
    </view>

    <view class="panel" wx:if="{{totals.length && roundSize > 1}}">
      <view class="panel-title">本轮累计（{{roundIndex}} / {{roundSize}} 局）</view>
      <view wx:for="{{totals}}" wx:key="seat" class="total-row">
        <view class="total-name">{{item.name}}</view>
        <view class="total-val {{item.total>0?'up':'down'}}">{{item.total>0?'+':''}}{{item.total}}</view>
      </view>
      <!-- [DESIGN 2026-11-19] 逐局得分：一轮 5 局的冠亚分差实测平均 25 分、标准差 16，
           只给一个总分玩家看不出差距是第几局拉开的，输了也不知道输在哪。 -->
      <view wx:if="{{roundDone && history.length}}" class="hist-block">
        <view class="total-tip">逐局得分</view>
        <view class="hist-grid">
          <view wx:for="{{history}}" wx:key="no" class="hist-cell {{item.multiplier>1?'bombed':''}}">
            <view class="hist-idx">第{{item.no}}局</view>
            <view class="hist-val {{item.delta>0?'up':item.delta<0?'down':'flat'}}">{{item.delta>0?'+':''}}{{item.delta}}</view>
            <view wx:if="{{item.multiplier>1}}" class="hist-mx">×{{item.multiplier}}</view>
          </view>
        </view>
      </view>
      <view wx:if="{{roundPeakText}}" class="total-tip peak">{{roundPeakText}}</view>
      <view wx:if="{{roundDone}}" class="total-tip">本轮已结束，开新一轮重新计分</view>
    </view>
  </block>

  <view class="btn-row" wx:if="{{!noData}}">
    <button class="btn" bindtap="onAgain">{{againLabel}}</button>
    <button class="btn btn-outline" bindtap="onHome">返回首页</button>
  </view>
  <button wx:else class="btn btn-block" bindtap="onHome">返回首页</button>

  <block wx:if="{{!noData}}">
    <view class="share-row">
      <view class="share-link" bindtap="onSavePoster">保存战绩图</view>
      <view class="share-dot">/</view>
      <button class="share-link share-btn" open-type="share">分享给好友</button>
    </view>
  </block>

  <!-- 战绩图离屏画布 -->
  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
