.result-page { padding-top: 60rpx; }
.result-head { text-align: center; margin-bottom: 40rpx; }
.result-badge {
  width: 120rpx; height: 120rpx; line-height: 120rpx; margin: 0 auto 24rpx;
  border-radius: 50%; font-size: 52rpx; font-weight: 500;
}
.result-badge.win { background: var(--gold); color: #2A1216; }
.result-badge.lose { background: rgba(192,69,60,0.2); color: var(--red); border: 2rpx solid var(--red); }
.result-title { font-size: 40rpx; font-weight: 500; color: var(--ink); }
.result-sub { font-size: 22rpx; color: var(--gold-dim); margin-top: 12rpx; }
.score-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0; border-bottom: 1rpx solid rgba(232,197,122,0.1);
}
.score-left { display: flex; align-items: center; gap: 16rpx; }
.rank-chip {
  width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center;
  border-radius: 50%; background: rgba(232,197,122,0.15); color: var(--gold-dim); font-size: 24rpx;
}
.rank-chip.first { background: var(--gold); color: #2A1216; font-weight: 500; }
.score-name { font-size: 28rpx; color: var(--ink); }
.score-delta { font-size: 30rpx; font-weight: 500; }
.score-delta.up { color: #E05A4E; }
.score-delta.down { color: #6FB98A; }
.btn-row { display: flex; gap: 20rpx; margin-top: 8rpx; }
.btn-row .btn { flex: 1; }
.share-btn { margin-top: 20rpx; }
