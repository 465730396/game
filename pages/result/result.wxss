.result-page { padding-top: 48rpx; }

/* ---------- 结算头：奖章 + 大标题 ---------- */
.result-head { position: relative; text-align: center; margin-bottom: 34rpx; }
.medal-wrap {
  position: relative;
  width: 190rpx; height: 190rpx;
  margin: 0 auto 18rpx;
  display: flex; align-items: center; justify-content: center;
}
.medal-wrap::before {
  content: '';
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background-image: radial-gradient(circle, rgba(235, 203, 132, 0.30) 0%, rgba(235, 203, 132, 0.06) 52%, rgba(0, 0, 0, 0) 72%);
}
.result-badge {
  position: relative;
  width: 128rpx; height: 128rpx; line-height: 128rpx;
  border-radius: 50%;
  text-align: center;
  font-size: 48rpx; font-weight: 800; letter-spacing: 2rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.result-badge.win {
  background-image: linear-gradient(160deg, #F8E4AE 0%, #DCB76C 52%, #B98A45 100%);
  color: #3A1B12;
  box-shadow: 0 12rpx 32rpx rgba(199, 154, 78, 0.45), inset 0 2rpx 0 rgba(255, 255, 255, 0.7), 0 0 0 6rpx rgba(235, 203, 132, 0.14);
}
.result-badge.lose {
  background-image: linear-gradient(160deg, rgba(169, 50, 40, 0.92), rgba(82, 24, 22, 0.96));
  color: #FFE4DC;
  border: 2rpx solid rgba(222, 90, 76, 0.55);
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.46), inset 0 1rpx 0 rgba(255, 180, 165, 0.3);
}
.result-badge.draw {
  background-image: linear-gradient(160deg, rgba(235, 203, 132, 0.20), rgba(235, 203, 132, 0.05));
  color: var(--gold);
  border: 2rpx solid rgba(235, 203, 132, 0.45);
  font-size: 40rpx;
}
.result-title {
  font-size: 42rpx; font-weight: 700; color: var(--ink); letter-spacing: 4rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.result-sub { font-size: 21rpx; color: var(--gold-dim); margin-top: 12rpx; letter-spacing: 1rpx; }
.result-multi {
  display: inline-block; margin-top: 14rpx;
  padding: 4rpx 16rpx; border-radius: 8rpx;
  font-size: 21rpx; color: #FFD9D3;
  background: rgba(169, 50, 40, 0.55);
  border: 1rpx solid rgba(222, 90, 76, 0.5);
}
.daily-tip { font-size: 20rpx; color: var(--gold-dim); margin-top: 14rpx; line-height: 1.5; }

/* ---------- 积分榜 ---------- */
.score-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(235, 203, 132, 0.08);
}
.score-row:last-child { border-bottom: none; }
.score-left { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.rank-chip {
  width: 46rpx; height: 46rpx; line-height: 46rpx; text-align: center; flex: 0 0 auto;
  border-radius: 50%;
  background: rgba(235, 203, 132, 0.10);
  color: var(--gold-dim);
  font-size: 23rpx; font-weight: 700;
  font-family: "DIN Alternate", sans-serif;
}
.rank-chip.first {
  background-image: linear-gradient(180deg, #F6E0A6, #C79A4E);
  color: #3A1B12;
  box-shadow: 0 4rpx 12rpx rgba(199, 154, 78, 0.4);
}
.rank-chip.second {
  background-image: linear-gradient(180deg, rgba(226, 226, 232, 0.9), rgba(150, 152, 162, 0.9));
  color: #23201F;
}
.score-info { display: flex; flex-direction: column; min-width: 0; }
.score-name { font-size: 28rpx; color: var(--ink); }
.score-sub { font-size: 21rpx; color: var(--gold-dim); margin-top: 4rpx; }
.score-delta {
  font-size: 34rpx; font-weight: 800;
  font-family: "DIN Alternate", "Helvetica Neue", sans-serif;
}
.score-delta.up { color: var(--red-2); }
.score-delta.down { color: var(--jade); }

/* ---------- 本轮累计 ---------- */
.total-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(235, 203, 132, 0.08);
}
.total-name { font-size: 26rpx; color: var(--ink); }
.total-val { font-size: 29rpx; font-weight: 700; font-family: "DIN Alternate", sans-serif; }
.total-val.up { color: var(--red-2); }
.total-val.down { color: var(--jade); }
.total-tip { font-size: 21rpx; color: var(--gold-dim); margin-top: 14rpx; }
.hist-block { margin-top: 18rpx; }
.hist-grid { display: flex; gap: 10rpx; margin-top: 10rpx; }
.hist-cell {
  flex: 1; text-align: center;
  background: rgba(235, 203, 132, 0.06);
  border: 1rpx solid rgba(235, 203, 132, 0.10);
  border-radius: 10rpx;
  padding: 10rpx 0;
}
.hist-idx { font-size: 19rpx; color: var(--gold-dim); }
.hist-val { font-size: 26rpx; font-weight: 700; font-family: "DIN Alternate", sans-serif; }
.hist-val.up { color: var(--red-2); }
.hist-val.down { color: var(--jade); }
.hist-val.flat { color: var(--gold-dim); }

/* ---------- 底部操作 ---------- */
.btn-row { display: flex; gap: 18rpx; margin-top: 12rpx; }
.btn-row .btn { flex: 1; }
.share-row {
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
  margin-top: 30rpx;
}
.share-link {
  padding: 0; margin: 0; background: transparent; border: none; line-height: 1.6;
  font-size: 24rpx; color: var(--gold-dim); letter-spacing: 1rpx;
  border-bottom: 1rpx solid rgba(235, 203, 132, 0.22);
}
.share-link::after { border: none; }
.share-btn { display: inline-block; }
.share-dot { color: var(--gold-dim); font-size: 24rpx; }

.poster-canvas { position: fixed; left: -9999px; top: 0; width: 375px; height: 500px; }
