<view class="page index-page {{largeFont?'large-font':''}}">
  <!-- HERO：这块决定第一眼是不是"游戏"。大字号 + 双色辉光 + 竖向水印，替代原来的小印章 + 两行字 -->
  <view class="hero">
    <view class="hero-scan"></view>
    <view class="hero-top">
      <view class="hero-kicker"><text class="k-dot"></text>SHAANBEI · NEON SHADOW</view>
      <view class="hero-hud" data-page="stats" bindtap="onNav">
        <view class="hud-row">
          <text class="hud-num">{{statRate}}</text>
          <text class="hud-unit">%</text>
        </view>
        <view class="hud-cap">胜率 · {{statGames}} 局</view>
      </view>
    </view>

    <view class="hero-title">
      <view class="hero-pre">陕 北</view>
      <view class="glitch" data-text="捉老麻">捉老麻</view>
      <view class="hero-en">ZHUO LAO MA</view>
    </view>

    <view class="hero-tags">
      <text class="hero-tag">48 张牌 · 唯一 1 张 2</text>
      <text class="hero-tag">见 K 必出 A</text>
      <text class="hero-tag">人机 · 热座</text>
    </view>
  </view>

  <!-- 续局：霓虹告警条 -->
  <view class="resume" wx:if="{{hasSession}}">
    <view class="resume-bar"></view>
    <view class="resume-body">
      <view class="resume-kicker"><text class="live-dot"></text>未完成 · PAUSED</view>
      <view class="resume-title">接着上一局</view>
      <view class="resume-desc">{{sessionDesc}}</view>
    </view>
    <view class="resume-actions">
      <view class="resume-go" bindtap="onContinue">继续</view>
      <view class="resume-drop" bindtap="onDiscardSession">放弃</view>
    </view>
  </view>

  <!-- 主卡：开局设置 -->
  <view class="panel board">
    <view class="board-head">
      <view class="board-title">快速开局</view>
      <view class="board-sub">人机对战 · 自动记牌</view>
    </view>

    <view class="opt">
      <view class="opt-label">人数</view>
      <view class="pill-group">
        <view wx:for="{{counts}}" wx:key="*this" class="pill {{aiCount===item?'on':''}}" data-count="{{item}}" bindtap="onAiCount">{{item}} 人</view>
      </view>
    </view>

    <view class="opt">
      <view class="opt-label">难度</view>
      <view class="pill-group">
        <view wx:for="{{levels}}" wx:key="value" class="pill {{aiLevel===item.value?'on':''}}" data-level="{{item.value}}" bindtap="onAiLevel">{{item.label}}</view>
      </view>
    </view>

    <view class="opt">
      <view class="opt-label">规则</view>
      <view class="pill-group">
        <view wx:for="{{rules}}" wx:key="value" class="pill {{ruleMode===item.value?'on':''}}" data-value="{{item.value}}" bindtap="onRuleMode">{{item.label}}</view>
      </view>
    </view>

    <view class="opt-hint">{{ruleMode==='SIMPLE' ? '简化档：关闭见K必出A、见A必出2、见2必出炸弹等强制规则' : '经典档：保留见K必出A、见A必出2、见2必出炸弹等强制规则'}}</view>

    <button class="btn btn-block btn-start" bindtap="onStartAi">开 始 对 局</button>
  </view>

  <!-- 每日挑战：酸性描边卡，日期做成发光数字 -->
  <view class="daily" bindtap="onDaily">
    <view class="daily-date">
      <view class="daily-d">{{dayNum}}</view>
      <view class="daily-m">{{monthNum}} 月</view>
    </view>
    <view class="daily-body">
      <view class="daily-title">每日挑战<text wx:if="{{dailyDone}}" class="daily-done">已完成</text></view>
      <view class="daily-desc">{{dailyDesc}}</view>
    </view>
    <view class="daily-cta">{{dailyDone ? '再练' : '开战'}}</view>
  </view>

  <!-- 同屏热座 -->
  <view class="panel hotseat">
    <view class="hotseat-head">
      <view class="hotseat-title">同屏热座</view>
      <view class="hotseat-desc">一台手机轮流传着打</view>
    </view>
    <view class="hotseat-row">
      <view class="pill-group hotseat-pills">
        <view wx:for="{{counts}}" wx:key="*this" class="pill {{hotCount===item?'on':''}}" data-count="{{item}}" bindtap="onHotCount">{{item}} 人</view>
      </view>
      <button class="btn hotseat-btn" bindtap="onStartHot">开始</button>
    </view>
  </view>

  <view class="nav-grid">
    <view class="nav-item" data-page="rules" bindtap="onNav">
      <view class="nav-glyph">规</view>
      <view class="nav-label">玩法规则</view>
    </view>
    <view class="nav-item" data-page="stats" bindtap="onNav">
      <view class="nav-glyph">绩</view>
      <view class="nav-label">战绩统计</view>
    </view>
    <view class="nav-item" data-page="settings" bindtap="onNav">
      <view class="nav-glyph">设</view>
      <view class="nav-label">设 置</view>
    </view>
  </view>
</view>
