/* 全局样式：陕北夜宴主题。rpx 自适应，安全区底部留白。 */
page {
  --bg-deep: #1B1018;
  --bg-panel: #2E1A1C;
  --gold: #E8C57A;
  --gold-dim: #B9975B;
  --ink: #F4E9D8;
  --red: #C0453C;
  background: var(--bg-deep);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
}

.panel {
  background: var(--bg-panel);
  border: 1rpx solid rgba(232, 197, 122, 0.18);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--gold);
  margin-bottom: 20rpx;
  border-left: 6rpx solid var(--gold);
  padding-left: 16rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
  background: linear-gradient(180deg, #D9B36A, #B68A45);
  color: #2A1216;
  border: none;
  line-height: 1;
}
.btn::after { border: none; }
.btn[disabled] { opacity: 0.45; }
.btn-outline {
  background: transparent;
  border: 1rpx solid var(--gold-dim);
  color: var(--gold);
}
.btn-block { width: 100%; }

.row-label {
  font-size: 26rpx;
  color: var(--gold-dim);
  margin: 20rpx 0 12rpx;
}

.segmented {
  display: flex;
  border: 1rpx solid rgba(232, 197, 122, 0.3);
  border-radius: 14rpx;
  overflow: hidden;
}
.segmented .seg {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--ink);
  background: transparent;
  border-right: 1rpx solid rgba(232, 197, 122, 0.2);
}
.segmented .seg:last-child { border-right: none; }
.segmented .seg.on { background: var(--gold); color: #2A1216; font-weight: 500; }

.muted { color: var(--gold-dim); font-size: 24rpx; }
.center { text-align: center; }
.large-font .card-rank { font-size: 40rpx !important; }
.large-font .rule-p { font-size: 32rpx !important; }
