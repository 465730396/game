/* 全局设计系统：陕北夜宴 · 剪纸鎏金
   设计意图（这一版为什么这么改）：
   1) 旧版所有面板都是同一种灰红方块 + 同一种金色按钮，主次不分，像设置表单而不像游戏。
      现在建立 3 级层次：漆木台面(panel) / 鎏金主键(btn) / 描边次键(btn-outline)，
      并用"底部暗边 + 顶部高光"做出实体按键的厚度感。
   2) 牌桌是主角，牌面必须像牌：羊皮纸底、细金边、左上角点数 + 花色、中央暗纹。
   3) 标题用衬线（宋体）拉开民俗感，数字用等宽感字重，避免全篇苹方造成的"后台页面"气质。 */

page {
  --bg-deep: #0C0709;
  --bg-deep-2: #1A0F12;
  --bg-panel: #241315;
  --bg-panel-2: #321A1D;
  --gold: #EBCB84;
  --gold-2: #C79A4E;
  --gold-dim: #9C7C4C;
  --ink: #F3E7D3;
  --ink-dim: #C2AE93;
  --red: #A93228;
  --red-2: #DE5A4C;
  --jade: #6FB98A;
  --paper: #F8F1E1;

  background-color: var(--bg-deep);
  background-image:
    radial-gradient(120% 46% at 50% -6%, rgba(178, 58, 48, 0.30) 0%, rgba(120, 40, 34, 0.10) 42%, rgba(0, 0, 0, 0) 70%),
    radial-gradient(90% 40% at 50% 106%, rgba(150, 108, 46, 0.18) 0%, rgba(0, 0, 0, 0) 72%),
    linear-gradient(180deg, #150C0F 0%, #0C0709 58%, #0A0608 100%);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(52rpx + env(safe-area-inset-bottom));
}

/* ---------- 漆木台面 ---------- */
.panel {
  position: relative;
  background-image: linear-gradient(165deg, rgba(62, 34, 35, 0.94) 0%, rgba(36, 19, 22, 0.97) 62%, rgba(28, 15, 18, 0.98) 100%);
  border: 1rpx solid rgba(235, 203, 132, 0.16);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.42), inset 0 1rpx 0 rgba(255, 226, 170, 0.10);
  overflow: hidden;
}
/* 台面上沿一道斜射金光，解决"整块颜色平铺"的塑料感 */
.panel::before {
  content: '';
  position: absolute;
  left: 28rpx; right: 28rpx; top: 0;
  height: 1rpx;
  background-image: linear-gradient(90deg, rgba(0, 0, 0, 0), rgba(235, 203, 132, 0.55), rgba(0, 0, 0, 0));
}

.panel-title {
  display: flex;
  align-items: center;
  font-size: 29rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: var(--gold);
  margin-bottom: 20rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.panel-title::before {
  content: '';
  width: 12rpx; height: 12rpx;
  margin-right: 14rpx;
  background: var(--gold);
  transform: rotate(45deg);
  box-shadow: 0 0 12rpx rgba(235, 203, 132, 0.7);
  flex: 0 0 auto;
}

/* ---------- 按钮：做成有厚度的实体键 ---------- */
.btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  border-radius: 16rpx;
  background-image: linear-gradient(180deg, #F6E0A6 0%, #E2C078 34%, #C1934B 72%, #A87A39 100%);
  color: #3A1B12;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  line-height: 1;
  border: none;
  box-shadow:
    0 8rpx 0 #6E4A1E,
    0 14rpx 26rpx rgba(0, 0, 0, 0.46),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.62),
    inset 0 -3rpx 0 rgba(90, 58, 20, 0.35);
  transition: transform 120ms ease, box-shadow 120ms ease;
}
.btn::after { border: none; }
.btn.button-hover {
  transform: translateY(5rpx);
  box-shadow: 0 3rpx 0 #6E4A1E, 0 6rpx 12rpx rgba(0, 0, 0, 0.4), inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
}
.btn[disabled] {
  background-image: linear-gradient(180deg, rgba(120, 96, 74, 0.55), rgba(70, 52, 40, 0.55));
  color: rgba(243, 231, 211, 0.35);
  box-shadow: inset 0 0 0 1rpx rgba(235, 203, 132, 0.12);
}

.btn-outline {
  background-image: linear-gradient(180deg, rgba(235, 203, 132, 0.12), rgba(235, 203, 132, 0.03));
  color: var(--gold);
  border: 1rpx solid rgba(235, 203, 132, 0.42);
  box-shadow: 0 6rpx 0 rgba(58, 34, 14, 0.55), 0 10rpx 20rpx rgba(0, 0, 0, 0.32), inset 0 1rpx 0 rgba(255, 226, 170, 0.16);
  letter-spacing: 2rpx;
}
.btn-outline.button-hover {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 rgba(58, 34, 14, 0.55), inset 0 1rpx 0 rgba(255, 226, 170, 0.12);
}
.btn-outline[disabled] {
  border-color: rgba(235, 203, 132, 0.14);
  color: rgba(235, 203, 132, 0.30);
  background-image: none;
  box-shadow: none;
}
.btn-block { width: 100%; }

/* ---------- 分段选择：做成可按的金牌，不再像系统设置项 ---------- */
.pill-group {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  border-radius: 18rpx;
  background-image: linear-gradient(180deg, rgba(0, 0, 0, 0.42), rgba(0, 0, 0, 0.18));
  border: 1rpx solid rgba(235, 203, 132, 0.12);
  box-shadow: inset 0 2rpx 6rpx rgba(0, 0, 0, 0.45);
}
.pill {
  flex: 1;
  height: 66rpx;
  line-height: 66rpx;
  text-align: center;
  border-radius: 13rpx;
  font-size: 27rpx;
  color: var(--ink-dim);
  letter-spacing: 1rpx;
}
.pill.on {
  background-image: linear-gradient(180deg, #F3D792 0%, #D2A75B 100%);
  color: #3A1B12;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.45), inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

/* 兼容旧页面（规则/统计/设置仍在用 segmented） */
.segmented { display: flex; border: 1rpx solid rgba(235, 203, 132, 0.3); border-radius: 14rpx; overflow: hidden; }
.segmented .seg {
  flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx;
  color: var(--ink); background: transparent;
  border-right: 1rpx solid rgba(235, 203, 132, 0.2);
}
.segmented .seg:last-child { border-right: none; }
.segmented .seg.on { background: var(--gold); color: #2A1216; font-weight: 600; }

/* ---------- 牌面：羊皮纸 + 细金边 + 角标 ---------- */
.card {
  position: relative;
  width: 96rpx;
  height: 136rpx;
  border-radius: 12rpx;
  flex: 0 0 auto;
  overflow: hidden;
  background-color: #FBF4E4;
  background-image:
    radial-gradient(120% 90% at 78% 10%, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 60%),
    linear-gradient(168deg, #FFFDF5 0%, #F4E6CB 58%, #E6D5B4 100%);
  border: 1rpx solid rgba(122, 90, 44, 0.55);
  box-shadow: 0 6rpx 14rpx rgba(0, 0, 0, 0.45), inset 0 0 0 2rpx rgba(255, 255, 255, 0.65);
}
.card-rank {
  position: absolute;
  left: 8rpx; top: 6rpx;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -1rpx;
  font-family: "DIN Alternate", "Helvetica Neue", "PingFang SC", sans-serif;
}
.card-suit { position: absolute; left: 9rpx; top: 46rpx; font-size: 26rpx; line-height: 1; }
/* 牌面中央的淡花色暗纹，让牌在叠压时仍有"这是一张牌"的质感 */
.card-mark {
  position: absolute;
  right: 6rpx; bottom: 2rpx;
  font-size: 62rpx;
  line-height: 1;
  opacity: 0.13;
  transform: rotate(-8deg);
}
.card.red { color: #B02B22; }
.card.black { color: #241E1B; }

/* ---------- 文本 ---------- */
.muted { color: var(--gold-dim); font-size: 24rpx; }
.center { text-align: center; }
.row-label { font-size: 25rpx; color: var(--ink-dim); margin: 18rpx 0 10rpx; letter-spacing: 1rpx; }

/* ---------- 遮罩 ---------- */
.mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(8, 4, 6, 0.90);
}
.mask-card {
  position: relative;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  padding: 44rpx 34rpx 34rpx;
  border-radius: 26rpx;
  background-image: linear-gradient(170deg, #3A1F21 0%, #241315 100%);
  border: 1rpx solid rgba(235, 203, 132, 0.45);
  box-shadow: 0 24rpx 60rpx rgba(0, 0, 0, 0.6), inset 0 1rpx 0 rgba(255, 226, 170, 0.2);
}
.mask-title {
  font-size: 38rpx;
  font-weight: 600;
  color: var(--gold);
  text-align: center;
  letter-spacing: 3rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  margin-bottom: 22rpx;
}

/* ---------- 大字模式 ---------- */
.large-font .card-rank { font-size: 44rpx !important; }
.large-font .card-suit { font-size: 32rpx !important; }
.large-font .card-mark { font-size: 74rpx !important; }
.large-font .rule-p { font-size: 32rpx !important; }
.large-font .panel-title { font-size: 34rpx !important; }
.large-font .setting-name { font-size: 32rpx !important; }
.large-font .setting-desc { font-size: 26rpx !important; }
.large-font .stat-num { font-size: 46rpx !important; }
.large-font .list-main { font-size: 30rpx !important; }
.large-font .result-title { font-size: 48rpx !important; }
.large-font .score-name { font-size: 32rpx !important; }
.large-font .status-line { font-size: 30rpx !important; }
.large-font .nav-label { font-size: 28rpx !important; }
.large-font .btn { font-size: 32rpx !important; }
